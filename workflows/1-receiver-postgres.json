    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO webhook_claims (event_key, status, owner, claimed_at)\nVALUES ($1, 'processing', $2, now())\nON CONFLICT (event_key) DO UPDATE\n  SET status = 'processing', owner = EXCLUDED.owner, claimed_at = now(), attempts = webhook_claims.attempts + 1\n  WHERE webhook_claims.status = 'failed'\n     OR (webhook_claims.status = 'processing'\n         AND webhook_claims.claimed_at < now() - make_interval(secs => $3::int))\nRETURNING owner, attempts;",
        "options": {
          "queryReplacement": "={{ [$json.event_key, $json.owner, $json.lease_seconds] }}"
        }
      },
      "id": "93b12424-a190-43b0-8b8d-d431c98342a7",
